#!/bin/bash
# Lint prose against voice.md's mechanical rules (Tier 1 of the voice gate).
#
# Usage:
#   voice-lint FILE...        lint files
#   voice-lint -              lint stdin
#   voice-lint --reader FILE  lint text for people who never saw the work: adds
#                             Voice.ProcessLeak, the working-terms list, and the
#                             cold read (a model with none of our context quotes
#                             what it can't interpret)
#   voice-lint --pr FILE      lint as a PR description: --reader plus the
#                             first-person rule
#   voice-lint --advisory ..  report findings but always exit 0
#   voice-lint --json ..      machine-readable output (Vale findings only)
#   voice-lint --glossary F ..  terms the reader does have, for the cold read
#
# Plans, handoffs, and research notes are for us and share our vocabulary, so
# they get the plain run; the --reader checks would flag every working term.
#
# Two per-worktree files extend --reader when they exist at the repo root:
#   .scratch/voice-terms         one working term per line (# comments). Each
#                                becomes a Terms.WorkingTerms warning, so a
#                                term caught once is caught everywhere after.
#   .scratch/voice-glossary.md   the cold read's default --glossary.
#
# Exits 1 when an error-level rule fires.
#
# Two ways off. VOICE_LINT=0 skips a single run. `git config voice.lint false`
# opts a whole repo out, for one whose commit conventions are not mine.
# VOICE_LINT_FORCE=1 ignores that opt-out (the publish gate sets it, since text
# bound for Notion or Slack is mine whatever the repo's conventions).
#
# Agent-facing docs (skills/, agents/, commands/, output-styles/, showrunner.md,
# CLAUDE.md, AGENTS.md) are exempt from Voice.EmDash: they are written for a
# model, not a reviewer, and the repo carries ~424 em dashes in that prose. Every
# other rule still applies to them.

set -u
CFGDIR="${CLAUDE_CONFIG_DIR:-$HOME/.config/claude}"
CFG="$CFGDIR/.vale.ini"
[ "${VOICE_LINT:-1}" = "0" ] && exit 0

# A repo whose conventions are not mine opts out: git config voice.lint false
if [ "${VOICE_LINT_FORCE:-0}" != "1" ] && git rev-parse --git-dir >/dev/null 2>&1; then
  case "$(git config --get voice.lint 2>/dev/null)" in
    false|0|off|no) exit 0 ;;
  esac
fi

if ! command -v vale >/dev/null 2>&1; then
  echo "voice-lint: vale not installed (brew install vale); skipping" >&2
  exit 0
fi

ADVISORY=0; FMT=line; ASPR=0; READER=0; GLOSSARY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --advisory) ADVISORY=1; shift ;;
    --reader) READER=1; shift ;;
    --glossary) GLOSSARY="${2:-}"; shift 2 ;;
    --json) FMT=JSON; shift ;;
    --pr) ASPR=1; READER=1; shift ;;
    *) break ;;
  esac
done

TMP=$(mktemp -d) || exit 0
trap 'rm -rf "$TMP"' EXIT

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
TERMS="${VOICE_TERMS:-${ROOT:+$ROOT/.scratch/voice-terms}}"
if [ -z "$GLOSSARY" ] && [ -n "$ROOT" ] && [ -f "$ROOT/.scratch/voice-glossary.md" ]; then
  GLOSSARY="$ROOT/.scratch/voice-glossary.md"
fi

# Working terms become a generated Vale style next to Voice. Each line is a
# literal phrase; Vale's existence rule adds the word boundaries.
if [ "$READER" = "1" ] && [ -n "$TERMS" ] && [ -f "$TERMS" ] && grep -qv '^[[:space:]]*\(#\|$\)' "$TERMS"; then
  mkdir -p "$TMP/styles/Terms"
  ln -s "$CFGDIR/styles/Voice" "$TMP/styles/Voice"
  {
    echo 'extends: existence'
    echo "message: \"Working term from .scratch/voice-terms: '%s'. A reader never saw it; say what it means.\""
    echo 'level: warning'
    echo 'ignorecase: true'
    echo 'tokens:'
    grep -v '^[[:space:]]*\(#\|$\)' "$TERMS" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
      -e 's/[][\\.*^$+?(){}|]/\\&/g' -e "s/'/''/g" -e "s/^/  - '/" -e "s/$/'/"
  } > "$TMP/styles/Terms/WorkingTerms.yml"
  sed -e "s|^StylesPath = .*|StylesPath = $TMP/styles|" \
      -e 's|^BasedOnStyles = Voice$|BasedOnStyles = Voice, Terms|' "$CFG" > "$TMP/vale.ini"
  CFG="$TMP/vale.ini"
fi

# Written for a model rather than a reviewer; see the header note.
is_agent_facing() {
  case "$(cd "$(dirname "$1")" 2>/dev/null && pwd)/$(basename "$1")" in
    "$CFGDIR"/skills/*|"$CFGDIR"/agents/*|"$CFGDIR"/commands/*|"$CFGDIR"/output-styles/*) return 0 ;;
  esac
  case "$(basename "$1")" in
    showrunner.md|CLAUDE.md|AGENTS.md) return 0 ;;
  esac
  return 1
}

PROSE=(); AGENT=()
for arg in "$@"; do
  if [ "$arg" = "-" ]; then
    name=stdin.md; [ "$ASPR" = "1" ] && name=PR_BODY.md
    cat > "$TMP/$name"; PROSE+=("$TMP/$name")
  elif [ -f "$arg" ]; then
    f="$arg"
    case "$arg" in
      # Real .md files pass through uncopied so per-file config sections
      # still match on the path.
      *.md) [ "$ASPR" = "1" ] && { cp "$arg" "$TMP/PR_BODY.md"; f="$TMP/PR_BODY.md"; } ;;
      # Anything else gets a .md name so Vale applies the Markdown parser.
      *) b=$(basename "$arg"); cp "$arg" "$TMP/${b%.*}.md"; f="$TMP/${b%.*}.md" ;;
    esac
    if is_agent_facing "$arg"; then AGENT+=("$f")
    else PROSE+=("$f"); fi
  fi
done

# The "write about the PR, not the author" rule is wrong everywhere else, and
# process language is only a fault in text for readers who never saw the work.
BASE=""
[ "$ASPR" = "0" ] && BASE='.Name!="Voice.PRFirstPerson"'
if [ "$READER" = "0" ]; then
  BASE="${BASE:+$BASE && }.Name!=\"Voice.ProcessLeak\""
fi
AGENT_F='.Name!="Voice.EmDash"'
[ -n "$BASE" ] && AGENT_F="$BASE && $AGENT_F"

status=0
run() {  # run <filter> <files...>
  local filt="$1"; shift
  [ $# -eq 0 ] && return 0
  # bash 3.2 + set -u: an empty array must be expanded with the += default form.
  local args=(); [ -n "$filt" ] && args=(--filter="$filt")
  vale --config="$CFG" ${args[@]+"${args[@]}"} --output="$FMT" --minAlertLevel=suggestion "$@" | sed "s|$TMP/||g"
  # Exit 1 means an error-level alert. Exit 2 is a Vale runtime error: one file
  # with unparseable frontmatter aborts the whole batch, so it cannot read as clean.
  vale --config="$CFG" ${args[@]+"${args[@]}"} --output=JSON --minAlertLevel=error "$@" >/dev/null 2>&1 \
    || status=1
  return 0
}
run "$BASE" ${PROSE[@]+"${PROSE[@]}"}
run "$AGENT_F" ${AGENT[@]+"${AGENT[@]}"}

# The cold read: a model that has none of our context reads each prose file
# as its reader would and quotes what it can't interpret. Sonnet, because
# Haiku false-flagged a third of already-fixed sentences in testing. Agent-facing
# docs skip it: their reader shares our vocabulary. A failed or timed-out call
# reports itself and never fails the run.
cold_read() {  # cold_read <file> <label>
  local sys="$CFGDIR/voice-cold-read.md" prompt out rc d
  prompt=$(cat "$sys")
  if [ -n "$GLOSSARY" ] && [ -f "$GLOSSARY" ]; then
    prompt="$prompt

The reader also has this glossary:

$(cat "$GLOSSARY")"
  fi
  d=$(mktemp -d)
  out=$(cd "$d" && CLAUDE_SHOWRUNNER=0 timeout "${VOICE_COLD_TIMEOUT:-60}" claude -p \
    --model "${VOICE_COLD_MODEL:-sonnet}" --tools "" --no-session-persistence \
    --setting-sources "" --strict-mcp-config --system-prompt "$prompt" < "$1" 2>/dev/null)
  rc=$?
  rm -rf "$d"
  if [ $rc -ne 0 ] || [ -z "$out" ]; then
    echo "voice-lint: cold read unavailable for $2 (exit $rc); skipped" >&2
    return 0
  fi
  [ "$out" = "CLEAN" ] && return 0
  printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | sed "s|^|$2: cold read: |"
  status=1
}
if [ "$READER" = "1" ]; then
  for f in ${PROSE[@]+"${PROSE[@]}"}; do cold_read "$f" "${f#$TMP/}"; done
fi

[ "$ADVISORY" = "1" ] && exit 0
exit $status
